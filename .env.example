NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional: busca a foto do produto quando a loja bloqueia a leitura da página.
# Chave em https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# String aleatória longa, só do servidor; usada no hash diário anônimo de visitante em /api/t.
TRACK_SALT=

# Opcional: PostHog (funis e retenção). Sem a chave, nada é enviado. Chave do projeto (pública), não a pessoal.
NEXT_PUBLIC_POSTHOG_KEY=
# Região do projeto: us.i.posthog.com (EUA) ou eu.i.posthog.com (UE).
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
