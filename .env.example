NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional: busca a foto do produto quando a loja bloqueia a leitura da página.
# Chave em https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Só em produção (Vercel). Em localhost deixe vazia: sem ela /api/t descarta o evento e o localhost não gera métrica.
# Em produção assina o visitante anônimo em /api/t; o MESMO valor vai para o Vault do Supabase (secret `track_salt`):
#   select vault.create_secret('<valor de TRACK_SALT>', 'track_salt');
TRACK_SALT=

# Opcional: PostHog (funis e retenção). Sem a chave, nada é enviado. Chave do projeto (pública), não a pessoal.
NEXT_PUBLIC_POSTHOG_KEY=
# Região do projeto: us.i.posthog.com (EUA) ou eu.i.posthog.com (UE).
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
